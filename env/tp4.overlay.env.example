# 叠在 knapcio .env.tp4.example 之上的本机覆盖项。
# 不要整文件替换上游模板：站点 IP、网卡、SSH、权重路径仍按你的集群改模板。
#
# CONTEXT_LENGTH 是引擎总长，不是「只有 prompt」。
# 客户端若 prompt=500000、max_tokens=100000，这里写 600000。

IMAGE=dsv41-4x-spark:v22-roce-sw1
BUILD_DOCKERFILE=Dockerfile.canary-roce
PORT=8001
# 容器名须与哨兵盯的名字一致（本机用 vllm_dsv41，历史名字）
# CONTAINER_NAME=vllm_dsv41

CONTEXT_LENGTH=600000
DSV41_MAX_NEW_TOKENS=100000
MAX_RUNNING_REQUESTS=4
MAX_TOTAL_TOKENS=2500000
MEM_FRACTION_STATIC=0.80
# CHUNKED_PREFILL_SIZE 与 DSV41_CACHE_GIB 保持上游默认（4096 / 4），除非你量过

EP_SIZE=1
NFS_SHARE=0

# 加载期（只影响装权，不影响稳态 DE/PR）
DSV41_FAST_LOAD_INFLIGHT_GB=1
DSV41_FAST_LOAD_THREADS=2
SGLANG_ENABLE_TP_MEMORY_INBALANCE_CHECK=0

# EXTRA_SGLANG_ARGS 须含下面两项（apply 脚本会补 PDI）。
# 缺 pil：worker 会卡在未鉴权的 `cargo --version --verbose` 数分钟。
# EXTRA_SGLANG_ARGS="... --image-processor-backend pil --prefill-decode-interval 1"

# 本机网卡名示例（以 ip / ibdev2netdev 为准）
# NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
# 数据口示例：enp1s0f0np0
